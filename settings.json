{
  "env": {
    "EDITOR": "gedit",
    "VISUAL": "gedit"
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(uv:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Agent"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/me/.claude/hooks/herdr-agent-state.sh' blocked",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/me/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/me/.claude/hooks/herdr-agent-state.sh' release",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/me/.claude/hooks/herdr-agent-state.sh' idle",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/me/.claude/hooks/herdr-agent-state.sh' working",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "stripe@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "skipAutoPermissionPrompt": true,
  "logging": {
    "enabled": true,
    "level": "info"
  },
  "safety": {
    "confirmBefore": [
      "Bash(rm:*)",
      "Bash(docker rm:*)",
      "Bash(git reset:*)"
    ],
    "warnOnDestructive": true
  },
  "terminal": {
    "captureStderr": true,
    "maxOutputLines": 5000,
    "timeout": 60000
  },
  "tui": "fullscreen"
}
